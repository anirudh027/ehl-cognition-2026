# Copy this file to .env.devin. Never commit the populated file.
DEVIN_API_KEY=cog_replace_with_supported_key
DEVIN_ORG_ID=org-replace-with-your-org-id

# One managed dashboard run launches two specialists and one coordinator.
# This is a per-session cap, so 2 permits a theoretical maximum of 6 ACUs per run.
BIO_DASHBOARD_DEVIN_MAX_ACU=2
BIO_DASHBOARD_DEVIN_MODE=normal
BIO_DASHBOARD_DEVIN_REPO=anirudh027/ehl-cognition-2026
BIO_DASHBOARD_DEVIN_REPO_REF=main
